MYSQL_PASSWORD=robuxmart_secure_2024

# ============================================================================
# TARGET DATA WAREHOUSE: PostgreSQL 15 (Docker Container)
# ============================================================================
DWH_ENGINE=postgres         # Options: postgres | sqlite (local fallback for testing without Docker)
DWH_HOST=localhost
DWH_PORT=5433
DWH_DB=robuxmart_dwh
DWH_USER=dwh_admin
